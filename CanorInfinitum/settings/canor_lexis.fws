@lexis.encoding(charset="UTF-8", bom=off, newline=LF);
@lexis.whitespace:keep;
@lexis.path_header:bare_sigil;
@lexis.scripts(brace=required);
@lexis.hyphen(names={tag}, expression=minus);
@lexis.binding:kvp;
@lexis.equation{":=", "<=", ">=", "="};
@lexis.braket{braket, "<=", "<"};
@lexis.group_item{kvp, group, typed_atom, symbolic_atom};
@lexis.root(sigil=first_char, underscore=generic, script={"_{", "^{"});
@lexis.symbol{param, soul, glyph, name};
@lexis.number(base={2, 10, 16}, fraction=none);
@lexis.fragment(mode=auto, order={reference, bound, definition});
@lexis.comment:none;
@lexis.identity(key={sigil, header, version}, compare=case_insensitive);
@lexis.limits(ident=32, depth=16, rank=4);
