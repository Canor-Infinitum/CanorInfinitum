@names.scope{header, template, key, ini};
@names.form(start=letter, inner={letter, digit, "_"}, end={letter, digit}, compare=case_insensitive);
@names.global(form="__name__", use=internal, case=lower, locales=same);
@names.scoped(form="_name_", use={internal, project}, case=lower);
@names.limited(form="__name", use=project, case=lower);
@names.custom(form="_name", use=custom, case=lower);
@names.public(form="name", use=public, case=any);
@names.invalid:diagnose;
@names.case_duplicate:diagnose;
@names.translate:never;
@names.sigil_position(underscore=generic);
