ATOM_FILE = { ATOM_DEFINITION } ;
ATOM_DEFINITION = ATOM_PATH, HEADER, "::", TEMPLATE, PARAMETER_GROUP?, ( ":", ATOM_VALUE )?, ";" ;
ATOM_PATH = ROOT_PATH | TYPED_ATOM, { SELECTOR, TYPED_ATOM } ;
ROOT_PATH = ROOT_PATH_MARKER, (TYPED_ATOM, { SELECTOR, TYPED_ATOM })? ;
ROOT_PATH_MARKER = "&" | "%" | "$" | "#" | "@" | "?" | "!" | "^" | "~" | "/" | "\\" | "_" ;
SELECTOR = "." | "'" ;
TYPED_ATOM = LEFT_SUBSCRIPT?, LEFT_SUPERSCRIPT?, SYMBOL, RIGHT_SUBSCRIPT?, RIGHT_SUPERSCRIPT?, TENSOR_BRAKET? ;
LEFT_SUBSCRIPT = "_", INDEX ;
LEFT_SUPERSCRIPT = "^", INDEX ;
RIGHT_SUBSCRIPT = "_", INDEX ;
RIGHT_SUPERSCRIPT = "^", INDEX ;
INDEX = INDEX_TOKEN | "{", SYMBOLIC_ATOM, "}" ;
SYMBOL = NAME | SOUL_SYMBOL_REF | FONT_SCRIPT_GLYPH_REF | TEX_COMMAND ;
NAME = NAME_START, { NAME_CONTINUE } ;
NAME_START = UNICODE_LETTER | "_" ;
NAME_CONTINUE = UNICODE_LETTER | DIGIT | "_" | "-" ;
SOUL_SYMBOL_REF = REGISTERED_SOUL_SYMBOL_TOKEN ;
FONT_SCRIPT_GLYPH_REF = REGISTERED_FONT_GLYPH_TOKEN ;
TEX_COMMAND = "\\", NAME ;
HEADER = HEADER_BASE, { " ", HEADER_EXTENSION } ;
HEADER_BASE = HEADER_BASE_CHAR, { HEADER_BASE_CHAR } ;
HEADER_EXTENSION = HEADER_EXTENSION_CHAR, { HEADER_EXTENSION_CHAR } ;
HEADER_BASE_CHAR = ASCII_LETTER | DIGIT | "_" ;
HEADER_EXTENSION_CHAR = HEADER_BASE_CHAR | "-" ;
TEMPLATE = TEMPLATE_CHAR, { TEMPLATE_CHAR } ;
TEMPLATE_CHAR = UNICODE_LETTER | DIGIT | "&" | "%" | "$" | "#" | "@" | "?" | "!" | "^" | "~" | "/" | "\\" | "_" ;
PARAMETER_GROUP = MATHEMATICAL_GROUP ;
MATHEMATICAL_GROUP = UNKNOWN_SYMMETRIC_GROUP | ANTI_SYMMETRIC_GROUP | SYMMETRIC_GROUP | TENSOR_BRAKET ;
UNKNOWN_SYMMETRIC_GROUP = "{", GROUP_CONTENT?, "}" ;
ANTI_SYMMETRIC_GROUP = "[", GROUP_CONTENT?, "]" ;
SYMMETRIC_GROUP = "(", GROUP_CONTENT?, ")" ;
GROUP_CONTENT = GROUP_ITEM, { ",", GROUP_ITEM } ;
GROUP_ITEM = KEY_VALUE_PAIR | SYMBOLIC_ATOM | TYPED_ATOM | MATHEMATICAL_GROUP ;
TENSOR_BRAKET = "<", TENSOR_OBJECT, "|", TENSOR_OBJECT, ">" ;
TENSOR_OBJECT = TENSOR_VALUE, ("(", TENSOR_PROPERTY_LIST, ")")? ;
TENSOR_PROPERTY_LIST = TENSOR_PROPERTY, { ",", TENSOR_PROPERTY } ;
TENSOR_PROPERTY = "symmetric", ":", TENSOR_VALUE | "antisymmetric", ":", TENSOR_VALUE | "unknownsymmetric", ":", TENSOR_VALUE ;
TENSOR_VALUE = ATOM_PATH | QUOTED_STRING | SYMBOLIC_ATOM ;
ATOM_VALUE = QUOTED_STRING | KEY_VALUE_PAIR | MATHEMATICAL_GROUP | SYMBOLIC_ATOM ;
KEY_VALUE_PAIR = KEY, "=", ATOM_VALUE ;
KEY = NAME | QUOTED_STRING ;
SYMBOLIC_ATOM = DEFINING_EXPRESSION | DEFINING_EQUATION ;
DEFINING_EXPRESSION = EXPRESSION ;
DEFINING_EQUATION = EXPRESSION, EQUATION_OPERATOR, EXPRESSION ;
EXPRESSION = EXPRESSION_TOKEN, { EXPRESSION_TOKEN } ;
EXPRESSION_TOKEN = SYMBOL | NUMBER | OPERATOR | MATHEMATICAL_GROUP | QUOTED_STRING ;
QUOTED_STRING = "\"", { STRING_CHARACTER | ESCAPE_SEQUENCE }, "\"" ;
NUMBER = "0b", BIN_DIGIT, { BIN_DIGIT } | DIGIT, { DIGIT } | "0x", HEX_DIGIT, { HEX_DIGIT } ;
ASCII_LETTER = /[A-Za-z]/ ;
UNICODE_LETTER = /\p{L}/ ;
DIGIT = /[0-9]/ ;
BIN_DIGIT = "0" | "1" ;
HEX_DIGIT = /[0-9A-Fa-f]/ ;
INDEX_TOKEN = NAME | NUMBER | TEX_COMMAND ;
REGISTERED_SOUL_SYMBOL_TOKEN = NAME ;
REGISTERED_FONT_GLYPH_TOKEN = NAME ;
EQUATION_OPERATOR = "=" | ":=" | "<=" | ">=" ;
OPERATOR = "+" | "-" | "*" | "/" | "^" | "=" | "<" | ">" ;
ESCAPE_SEQUENCE = "\\", ("\\" | "\"" | "n" | "r" | "t") ;
STRING_CHARACTER = /[^"\\\r\n]/ ;
