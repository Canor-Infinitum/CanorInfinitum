 1  ATOM_FILE = { ATOM_DEFINITION } ;
 2  ATOM_DEFINITION = ATOM_PATH, HEADER, "::", TEMPLATE, PARAMETER_GROUP?, (":", ATOM_VALUE)?, ";" ;
 3  ATOM_PATH = ROOT_PATH | TYPED_ATOM, { SELECTOR, TYPED_ATOM } ;
 4  ROOT_PATH = ROOT_PATH_MARKER, (TYPED_ATOM, { SELECTOR, TYPED_ATOM })? ;
 5  ROOT_PATH_MARKER = "&" | "%" | "$" | "#" | "@" | "?" | "!" | "^" | "~" | "/" | "\\" | "_" ;
 6  SELECTOR = "." | "’" ;
 7  TYPED_ATOM = LEFT_SUBSCRIPT?, LEFT_SUPERSCRIPT?, SYMBOL, RIGHT_SUBSCRIPT?, RIGHT_SUPERSCRIPT?,
    TENSOR_BRAKET? ;
 8  LEFT_SUBSCRIPT = "_", INDEX ;
 9  LEFT_SUPERSCRIPT = "^", INDEX ;
10  RIGHT_SUBSCRIPT = "_", INDEX ;
11  RIGHT_SUPERSCRIPT = "^", INDEX ;
12  INDEX = INDEX_TOKEN | "{", SYMBOLIC_ATOM, "}" ;
13  SYMBOL = NAME | SOUL_SYMBOL_REF | FONT_SCRIPT_GLYPH_REF | TEX_COMMAND ;
14  NAME = NAME_START, { NAME_CONTINUE } ;
15  NAME_START = UNICODE_LETTER | "_" ;
16  NAME_CONTINUE = UNICODE_LETTER | DIGIT | "_" | "-" ;
17  SOUL_SYMBOL_REF = REGISTERED_SOUL_SYMBOL_TOKEN ;
18  FONT_SCRIPT_GLYPH_REF = REGISTERED_FONT_GLYPH_TOKEN ;
19  TEX_COMMAND = "\\", NAME ;
20  HEADER = HEADER_BASE, { " ", HEADER_EXTENSION } ;
21  HEADER_BASE = HEADER_BASE_CHAR, { HEADER_BASE_CHAR } ;
22  HEADER_EXTENSION = HEADER_EXTENSION_CHAR, { HEADER_EXTENSION_CHAR } ;
23  HEADER_BASE_CHAR = ASCII_LETTER | DIGIT | "_" ;
24  HEADER_EXTENSION_CHAR = HEADER_BASE_CHAR | "-" ;
25  TEMPLATE = TEMPLATE_CHAR, { TEMPLATE_CHAR } ;
26  TEMPLATE_CHAR = UNICODE_LETTER | DIGIT | "&" | "%" | "$" | "#" | "@" | "?" | "!" | "^" | "~" | "/" |
    "\\" | "_" ;
27  PARAMETER_GROUP = MATHEMATICAL_GROUP ;
28  MATHEMATICAL_GROUP = UNKNOWN_SYMMETRIC_GROUP | ANTI_SYMMETRIC_GROUP | SYMMETRIC_GROUP | TENSOR_BRAKET ;
29  UNKNOWN_SYMMETRIC_GROUP = "{", GROUP_CONTENT?, "}" ;
30  ANTI_SYMMETRIC_GROUP = "[", GROUP_CONTENT?, "]" ;
31  SYMMETRIC_GROUP = "(", GROUP_CONTENT?, ")" ;
32  GROUP_CONTENT = GROUP_ITEM, { ",", GROUP_ITEM } ;
33  GROUP_ITEM = KEY_VALUE_PAIR | SYMBOLIC_ATOM | TYPED_ATOM | MATHEMATICAL_GROUP ;
34  TENSOR_BRAKET = "<", TENSOR_OBJECT, "|", TENSOR_OBJECT, ">" ;
35  TENSOR_OBJECT = TENSOR_VALUE, ("(", TENSOR_PROPERTY_LIST, ")")? ;
36  TENSOR_PROPERTY_LIST = TENSOR_PROPERTY, { ",", TENSOR_PROPERTY } ;
37  TENSOR_PROPERTY = "symmetric", ":", TENSOR_VALUE | "antisymmetric", ":", TENSOR_VALUE |
    "unknownsymmetric", ":", TENSOR_VALUE ;
38  TENSOR_VALUE = ATOM_PATH | QUOTED_STRING | SYMBOLIC_ATOM ;
39  ATOM_VALUE = QUOTED_STRING | KEY_VALUE_PAIR | MATHEMATICAL_GROUP | SYMBOLIC_ATOM ;
40  KEY_VALUE_PAIR = KEY, "=", ATOM_VALUE ;
41  KEY = NAME | QUOTED_STRING ;
42  SYMBOLIC_ATOM = DEFINING_EXPRESSION | DEFINING_EQUATION ;
43  DEFINING_EXPRESSION = EXPRESSION ;
44  DEFINING_EQUATION = EXPRESSION, EQUATION_OPERATOR, EXPRESSION ;
45  EXPRESSION = EXPRESSION_TOKEN, { EXPRESSION_TOKEN } ;
46  EXPRESSION_TOKEN = SYMBOL | NUMBER | OPERATOR | MATHEMATICAL_GROUP | QUOTED_STRING ;
47  QUOTED_STRING = "\"", { STRING_CHARACTER | ESCAPE_SEQUENCE }, "\"" ;
48  NUMBER = "0b", BIN_DIGIT, { BIN_DIGIT } | DIGIT, { DIGIT } | "0x", HEX_DIGIT, { HEX_DIGIT } ;
49  ASCII_LETTER = /[A-Za-z]/ ;
50  UNICODE_LETTER = /\p{L}/ ;
51  DIGIT = /[0-9]/ ;
52  BIN_DIGIT = "0" | "1" ;
53  HEX_DIGIT = /[0-9A-Fa-f]/ ;
54  INDEX_TOKEN = NAME | NUMBER | TEX_COMMAND ;
55  REGISTERED_SOUL_SYMBOL_TOKEN = NAME ;
56  REGISTERED_FONT_GLYPH_TOKEN = NAME ;
57  EQUATION_OPERATOR = "=" | ":=" | "<=" | ">=" ;
58  OPERATOR = "+" | "-" | "*" | "/" | "^" | "=" | "<" | ">" ;
59  ESCAPE_SEQUENCE = "\\", ("\\" | "\"" | "n" | "r" | "t") ;
60  STRING_CHARACTER = % any character other than quote or backslash % ;
