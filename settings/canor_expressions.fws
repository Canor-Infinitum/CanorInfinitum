@op.power(glyph="^", level=1, assoc=right);
@op.script(glyph="_", level=1, assoc=left);
@op.juxtapose(glyph=" ", level=2, assoc=left);
@op.mul(glyph="*", level=3, assoc=left);
@op.div(glyph="/", level=3, assoc=left, exact=on);
@op.add(glyph="+", level=4, assoc=left);
@op.sub(glyph="-", level=4, assoc=left, unary=on);
@op.rel(glyph={"<", ">", "="}, level=5, assoc=chain);
@eq.define(glyph=":=", role=definition);
@eq.equal(glyph="=", role=equality);
@eq.le(glyph="<=", role=upper_bound);
@eq.ge(glyph=">=", role=lower_bound);
@tex.indices:split_letters;
@tex.einstein:on;
@tex.commands{in, notin, partial, nabla, sum, prod, otimes, oplus, wedge, cdot, times, frac, sqrt, delta, epsilon, alpha, beta, gamma, Gamma, mu, nu, rho, sigma, phi, psi};
