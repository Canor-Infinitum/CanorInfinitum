@sigil.amp(glyph="&", role=type, suffix=by_reference);
@sigil.dollar(glyph="$", role=variable, suffix=by_value);
@sigil.percent(glyph="%", role=modulation, suffix=modular);
@sigil.hash(glyph="#", role=index, suffix=indexed);
@sigil.at(glyph="@", role=registry, suffix=stored);
@sigil.query(glyph="?", role=candidate, suffix=partial);
@sigil.bang(glyph="!", role=effect, suffix=effectful);
@sigil.caret(glyph="^", role=upper, suffix=contravariant);
@sigil.under(glyph="_", role=generic, suffix=covariant);
@sigil.tilde(glyph="~", role=soul, suffix=interval);
@sigil.slash(glyph="/", role=resource, suffix=referenced);
@sigil.backslash(glyph="\\", role=tex, suffix=glyph);
@selector.dot(glyph=".", role=child);
@selector.prime(glyph="'", role=property);
